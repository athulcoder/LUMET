{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "Node",
        "outDir": "../dist-electron",
        "rootDir": "./",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": [
            "node"
        ],
        "sourceMap": true
    },
    "include": [
        "./**/*.ts"
    ]
}